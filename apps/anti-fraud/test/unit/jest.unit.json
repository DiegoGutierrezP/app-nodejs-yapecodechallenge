{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "../../../..",
  "testRegex": "apps/anti-fraud/test/unit/.*\\.spec\\.ts$",
  "testPathIgnorePatterns": [
    "/node_modules/",
    "/dist/",
    "/test/e2e/"
  ],
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "testEnvironment": "node",
  "moduleNameMapper": {
    "^apps/(.*)$": "<rootDir>/apps/$1"
  }
}
